{
  "pollIntervalSeconds": 60,
  "dashboardPort": 4400,
  "worktreeRoot": "C:/path/to/.fleet-worktrees",
  "stalledAfterMinutes": 10,
  "ticketTimeoutMinutes": 30,
  "approvalTimeoutMinutes": 10,
  "approvalPauseCapMinutes": 120,
  "approvalYieldMinutes": 30,
  "replyWaitMinutes": 60,
  "limitResumeSlackMinutes": 5,
  "limitDefaultBackoffMinutes": 300,
  "staleClaimMinutes": 45,
  "windowBudgetUsd": 8,
  "usageWindowHours": 5,
  "budgetLightThreshold": 0.85,
  "claudeExecutable": "C:/path/to/claude.exe",
  "dataDir": ".fleet",
  "workHoursReserve": {
    "workStart": "09:00",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "reserveHours": 2
  },
  "agents": ["claude"],
  "notifications": {
    "discordUrl": "https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "events": ["needs-input", "pr-opened", "failed", "paused", "auto-merged", "stale-released"],
    "digestTime": "09:00"
  },
  "discord": {
    "channelId": "000000000000000000",
    "allowedUserIds": ["000000000000000000"]
  },
  "projects": [
    {
      "name": "example",
      "repoPath": "C:/path/to/example",
      "githubRepo": "owner/example",
      "defaultBranch": "main",
      "maxConcurrent": 1,
      "maxInReview": 3,
      "setupCommand": "pnpm install",
      "model": "claude-opus-5-5",
      "elevatedModel": "claude-opus-5-5",
      "lightModel": "claude-sonnet-5",
      "effort": "medium",
      "elevatedEffort": "high",
      "lightEffort": "medium",
      "allowedTools": [],
      "planChildrenReady": false,
      "autoElevateOnFailure": true,
      "autoAddressReviews": true,
      "machineReview": true,
      "intakeLint": true,
      "autoMerge": false,
      "approvers": ["your-github-login"],
      "mergeMethod": "squash",
      "agents": ["claude", "codex"],
      "notifications": {
        "discordUrl": "https://discord.com/api/webhooks/111111111111111111/yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
        "events": ["needs-input", "pr-opened", "failed"]
      },
      "discord": {
        "channelId": "111111111111111111"
      }
    }
  ]
}
