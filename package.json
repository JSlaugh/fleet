{
  "name": "fleet",
  "private": true,
  "version": "0.0.1",
  "description": "Multi-project Claude Code backlog orchestrator: GitHub Issues in, reviewed PRs out.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter @fleet/dashboard typecheck",
    "build": "turbo run build",
    "daemon": "pnpm install && turbo run start --filter=@fleet/daemon --",
    "daemon:supervised": "node scripts/fleet-supervisor.mjs",
    "mcp": "pnpm --filter @fleet/mcp start",
    "dashboard:dev": "pnpm --filter @fleet/dashboard dev",
    "dashboard:build": "turbo run build --filter=@fleet/dashboard"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^20.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@11.5.1"
}
