{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@fleet/shared": ["./packages/shared/src/index.ts"],
      "@fleet/github": ["./packages/github/src/index.ts"],
      "@fleet/mcp/stamp": ["./packages/mcp/src/stamp/index.ts"]
    }
  }
}
