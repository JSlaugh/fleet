{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@fleet/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/shared/src/**/*.ts", "packages/daemon/src/**/*.ts", "packages/mcp/src/**/*.ts"]
}
